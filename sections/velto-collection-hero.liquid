{%- comment -%}
  Velto collection hero — replaces Dawn's plain collection title.
  - breadcrumb (Sākums › parent category › current)
  - big title with product count, short description
  - subcategory chips built from the main menu: on a top category its
    children, on a subcategory its siblings (current one highlighted),
    each with a small product thumbnail; swipe row on mobile
  - one-tap quick filter (default: "Lieliska cena") with its live count
    in this collection; toggles on/off
  - desktop: a small collage of 3 products from the collection
{%- endcomment -%}
{{ 'velto-collection.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign menu = section.settings.menu
  assign parent_link = nil
  for link in menu.links
    if link.active or link.child_active
      assign parent_link = link
      break
    endif
  endfor

  assign qf_name = ''
  assign qf_value = ''
  assign qf_count = 0
  assign qf_active = false
  if section.settings.quick_filter != blank
    assign qf_parts = section.settings.quick_filter | split: '='
    assign qf_name = qf_parts | first
    assign qf_value = section.settings.quick_filter | remove_first: qf_name | remove_first: '='
    for f in collection.filters
      for v in f.values
        if v.param_name == qf_name and v.value == qf_value
          assign qf_count = v.count
          if v.active
            assign qf_active = true
            assign qf_off_url = v.url_to_remove
          else
            assign qf_on_url = v.url_to_add
          endif
        endif
      endfor
    endfor
  endif

  comment
    Friendly titles for Shopify's built-in "all" collection (title "Products")
    and its tag / quick-filter views.
  endcomment
  assign ex_tag = settings.velto_badge_exclusive_tag | default: 'exclusive' | downcase
  assign title = collection.title | remove: '💙' | strip
  if collection.handle == 'all'
    assign title = 'velto.collection.all_title' | t
    if current_tags contains ex_tag
      assign title = 'velto.collection.exclusive_title' | t
    elsif qf_active
      capture title
        render 'velto-t', s: section.settings.quick_filter_label
      endcapture
    endif
  elsif current_tags contains ex_tag
    assign ex_label = 'velto.badges.exclusive_filter' | t
    assign title = title | append: ' · ' | append: ex_label
  endif
  comment
    Exclusive = product tag (theme setting). Tags are not storefront filters,
    so the chip uses Shopify's tag URL: /collections/<handle>/<tag>.
  endcomment
  assign ex_active = false
  if current_tags contains ex_tag
    assign ex_active = true
  endif
  assign ex_available = ex_active
  for t in collection.all_tags
    assign tl = t | downcase
    if tl == ex_tag
      assign ex_available = true
      assign ex_tag_raw = t
      break
    endif
  endfor
  if ex_tag_raw == blank
    assign ex_tag_raw = settings.velto_badge_exclusive_tag | default: 'exclusive'
  endif
  assign ex_on_url = collection.url | append: '/' | append: ex_tag_raw
  assign ex_off_url = collection.url
  assign has_filters = false
  if qf_count > 0 or qf_active or ex_available
    assign has_filters = true
  endif
  assign collage = collection.products | where: 'featured_media'
-%}

<section class="velto-coll-hero color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width velto-coll-hero__inner">
    <div class="velto-coll-hero__main">
      <nav class="velto-crumbs" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">{{ 'velto.home' | t }}</a>
        {%- if parent_link and parent_link.active == false -%}
          <span aria-hidden="true">/</span>
          <a href="{{ parent_link.url }}">{{ parent_link.title | remove: '💙' | strip }}</a>
        {%- endif -%}
        <span aria-hidden="true">/</span>
        <span aria-current="page">{{ title }}</span>
      </nav>

      <h1 class="velto-coll-hero__title">{{ title }}</h1>

      <p class="velto-coll-hero__meta">
        <span class="velto-coll-hero__count">{{ 'velto.products_count' | t: count: collection.products_count }}</span>
        {%- if qf_count > 0 and qf_active == false -%}
          <span class="velto-coll-hero__dot" aria-hidden="true"></span>
          <span>{% render 'velto-t', s: section.settings.quick_filter_label %}: {{ qf_count }}</span>
        {%- endif -%}
        {%- if ex_available and ex_active == false -%}
          <span class="velto-coll-hero__dot" aria-hidden="true" data-velto-ex-meta hidden></span>
          <span data-velto-ex-meta hidden>{{ 'velto.badges.exclusive_filter' | t }}: <span data-velto-ex-count></span></span>
        {%- endif -%}
      </p>

      {%- if section.settings.show_description and collection.description != blank -%}
        <div class="velto-coll-hero__desc rte">{{ collection.description | strip_html | truncatewords: 40 }}</div>
      {%- endif -%}
    </div>

    {%- if section.settings.show_collage and collage.size > 0 -%}
      <ul class="velto-coll-hero__collage" role="list" aria-hidden="true">
        {%- for p in collage limit: 3 -%}
          <li class="velto-coll-hero__tile">
            {{
              p.featured_media
              | image_url: width: 400
              | image_tag: loading: 'eager', sizes: '180px', widths: '200, 300, 400', alt: ''
            }}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>

  {%- if parent_link and parent_link.links.size > 0 or has_filters -%}
    <div class="page-width">
      <div class="velto-chips-wrap">
        <ul class="velto-chips" role="list">
          {%- if qf_count > 0 or qf_active -%}
            <li>
              <a
                class="velto-chip velto-chip--filter{% if qf_active %} is-active{% endif %}"
                href="{% if qf_active %}{{ qf_off_url }}{% else %}{{ qf_on_url }}{% endif %}"
                {% if qf_active %}aria-current="true"{% endif %}
              >
                <span class="velto-chip__spark" aria-hidden="true">{{- 'icon-price-tag.svg' | inline_asset_content -}}</span>
                {% render 'velto-t', s: section.settings.quick_filter_label %}
                {%- if qf_active %}<span class="velto-chip__x" aria-hidden="true">×</span>{% endif -%}
              </a>
            </li>
          {%- endif -%}
          {%- if ex_available -%}
            <li>
              <a
                class="velto-chip velto-chip--filter velto-chip--exclusive{% if ex_active %} is-active{% endif %}"
                href="{% if ex_active %}{{ ex_off_url }}{% else %}{{ ex_on_url }}{% endif %}"
                data-velto-keep-query
                {% if ex_active %}aria-current="true"{% endif %}
              >
                <span class="velto-chip__star" aria-hidden="true">✦</span>
                {{ 'velto.badges.exclusive_filter' | t }}
                {%- if ex_active %}<span class="velto-chip__x" aria-hidden="true">×</span>{% endif -%}
              </a>
            </li>
          {%- endif -%}
          {%- if has_filters and parent_link and parent_link.links.size > 0 -%}
            <li class="velto-chips__sep" aria-hidden="true"></li>
          {%- endif -%}

          {%- if parent_link and parent_link.links.size > 0 -%}
            <li>
              <a class="velto-chip{% if parent_link.active %} is-active{% endif %}" href="{{ parent_link.url }}"{% if parent_link.active %} aria-current="page"{% endif %}>
                {{ 'velto.all' | t }}
              </a>
            </li>
            {%- for child in parent_link.links -%}
              {%- if child.url == parent_link.url -%}{%- continue -%}{%- endif -%}
              {%- liquid
                assign img = nil
                if child.type == 'collection_link' and child.object
                  assign img = child.object.featured_image
                  if img == blank
                    assign img = child.object.products.first.featured_media.preview_image
                  endif
                endif
              -%}
              <li>
                <a class="velto-chip{% if child.active %} is-active{% endif %}" href="{{ child.url }}"{% if child.active %} aria-current="page"{% endif %}>
                  {%- if img != blank -%}
                    <span class="velto-chip__img">{{ img | image_url: width: 96 | image_tag: loading: 'eager', sizes: '34px', widths: '96', alt: '' }}</span>
                  {%- endif -%}
                  {{ child.title }}
                </a>
              </li>
            {%- endfor -%}
          {%- endif -%}
        </ul>
      </div>
    </div>
  {%- endif -%}
</section>

<script>
  (() => {
    // exclusive chip: keep the current query (filters, sort) when toggling the tag
    document.currentScript.previousElementSibling.querySelectorAll('[data-velto-keep-query]').forEach((a) => {
      const q = new URLSearchParams(location.search);
      q.delete('page');
      const qs = q.toString();
      if (qs) a.href = a.getAttribute('href').split('?')[0] + '?' + qs;
    });

    // live count of exclusives in this collection (tag views aren't facet counts)
    const exChip = document.currentScript.previousElementSibling.querySelector('.velto-chip--exclusive:not(.is-active)');
    const exMeta = document.querySelectorAll('[data-velto-ex-meta]');
    if (exChip && exMeta.length) {
      const url = exChip.getAttribute('href').split('?')[0] + '?section_id=main-collection-product-grid';
      fetch(url).then((r) => r.text()).then((html) => {
        const doc = new DOMParser().parseFromString(html, 'text/html');
        const txt = doc.querySelector('#ProductCountDesktop, .product-count__text')?.textContent || '';
        const n = parseInt(txt.trim().split(/\s+/)[0], 10);
        if (n > 0) {
          document.querySelector('[data-velto-ex-count]').textContent = n;
          exMeta.forEach((el) => (el.hidden = false));
        }
      }).catch(() => {});
    }

    // keep the active chip in view on mobile
    const row = document.currentScript.previousElementSibling.querySelector('.velto-chips');
    const active = row && row.querySelector('.velto-chip.is-active:not(.velto-chip--filter)');
    if (active && row.scrollWidth > row.clientWidth) {
      row.scrollLeft = active.offsetLeft - row.clientWidth / 2 + active.offsetWidth / 2;
    }
  })();
</script>

{% schema %}
{
  "name": "Velto kolekcijas galva",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Izvēlne apakškategorijām", "default": "main-menu" },
    { "type": "checkbox", "id": "show_description", "label": "Rādīt aprakstu", "default": true },
    { "type": "checkbox", "id": "show_collage", "label": "Rādīt produktu kolāžu (datorā)", "default": true },
    { "type": "header", "content": "Ātrais filtrs" },
    { "type": "text", "id": "quick_filter_label", "label": "Nosaukums", "default": "Lieliska cena" },
    {
      "type": "text",
      "id": "quick_filter",
      "label": "Filtra parametrs",
      "default": "filter.p.m.custom.price_category=gid://shopify/FilterSettingGroup/311165259",
      "info": "Nokopējiet no kolekcijas lapas adreses pēc filtra ieslēgšanas (param=vērtība). Tukšs — neslēpt."
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" }
  ]
}
{% endschema %}
