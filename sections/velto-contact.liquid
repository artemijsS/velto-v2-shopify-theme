{%- comment -%}
  Velto — contact page: contact cards (e-mail, phone, socials, company,
  live delivery schedule) + contact form card (name, e-mail, phone, topic,
  order number, message). Texts accept "@translation.key" values.
  The page's own content from Shopify admin is shown only if enabled.
{%- endcomment -%}
{{ 'velto-home.css' | asset_url | stylesheet_tag }}
{{ 'velto-about.css' | asset_url | stylesheet_tag }}
{{ 'velto-contact.css' | asset_url | stylesheet_tag }}
{{ 'velto-delivery.css' | asset_url | stylesheet_tag }}
<script src="{{ 'velto-delivery.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign ph = section.settings.phone | remove: ' '
-%}

<section
  class="velto-contact color-{{ section.settings.color_scheme }}"
  style="--velto-a-pt: {{ section.settings.padding_top }}px; --velto-a-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <nav class="velto-ahero__crumbs" aria-label="{{ 'velto.home' | t }}">
      <a href="{{ routes.root_url }}">{{ 'velto.home' | t }}</a>
      <span aria-hidden="true">/</span>
      <span>{{ page.title | default: shop.name }}</span>
    </nav>

    <div class="velto-contact__grid">
      <div class="velto-contact__info">
        {%- if section.settings.eyebrow != blank -%}
          <p class="velto-ahero__eyebrow">{% render 'velto-t', s: section.settings.eyebrow %}</p>
        {%- endif -%}
        <h1 class="velto-contact__title">{% render 'velto-t', s: section.settings.heading %}</h1>
        {%- if section.settings.text != blank -%}
          <div class="velto-contact__intro rte">{% render 'velto-t', s: section.settings.text %}</div>
        {%- endif -%}

        {%- if section.settings.show_page_content and page.content != blank -%}
          <div class="velto-contact__page rte">{{ page.content }}</div>
        {%- endif -%}

        <div class="velto-contact__cards">
          {%- if section.settings.email != blank -%}
            <a class="velto-ccard" href="mailto:{{ section.settings.email }}">
              <span class="velto-ccard__icon" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2.5" y="4.5" width="15" height="11" rx="1.5"/><path d="m3 5.5 7 5.5 7-5.5" stroke-linejoin="round"/></svg></span>
              <span class="velto-ccard__body">
                <span class="velto-ccard__label">{{ 'velto.footer.email' | t }}</span>
                <span class="velto-ccard__value">{{ section.settings.email }}</span>
                {%- if section.settings.email_hint != blank -%}
                  <span class="velto-ccard__hint">{% render 'velto-t', s: section.settings.email_hint %}</span>
                {%- endif -%}
              </span>
              <span class="velto-ccard__arrow" aria-hidden="true">→</span>
            </a>
          {%- endif -%}

          {%- if section.settings.phone != blank -%}
            <a class="velto-ccard" href="tel:{{ ph }}">
              <span class="velto-ccard__icon" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6.6 2.8 8.4 6.3a1 1 0 0 1-.2 1.2L6.9 8.7a10.6 10.6 0 0 0 4.4 4.4l1.2-1.3a1 1 0 0 1 1.2-.2l3.5 1.8a1 1 0 0 1 .5 1.1l-.5 2.1a1.6 1.6 0 0 1-1.6 1.2C8.7 17.6 2.4 11.3 2.2 4.4A1.6 1.6 0 0 1 3.4 2.8l2.1-.5a1 1 0 0 1 1.1.5Z" stroke-linejoin="round"/></svg></span>
              <span class="velto-ccard__body">
                <span class="velto-ccard__label">{{ 'velto.footer.phone' | t }}</span>
                <span class="velto-ccard__value">{{ section.settings.phone }}</span>
                {%- if section.settings.hours != blank -%}
                  <span class="velto-ccard__hint">{% render 'velto-t', s: section.settings.hours %}</span>
                {%- endif -%}
              </span>
              <span class="velto-ccard__arrow" aria-hidden="true">→</span>
            </a>
          {%- endif -%}

          {%- if settings.velto_delivery_enable -%}
            <velto-delivery
              class="velto-ccard velto-ccard--deliv"
              data-cutoff-day="{{ settings.velto_cutoff_day }}"
              data-cutoff-time="{{ settings.velto_cutoff_time }}"
              data-delivery-days="{{ settings.velto_delivery_days }}"
            >
              <span class="velto-ccard__icon" aria-hidden="true">{{- 'icon-truck.svg' | inline_asset_content -}}</span>
              <span class="velto-ccard__body">
                <span class="velto-ccard__label">{{ 'velto.delivery.delivery' | t }}</span>
                <span class="velto-ccard__value velto-ccard__value--sm">{{ 'velto.delivery.order' | t }} <span data-v="deadline"></span></span>
                <span class="velto-ccard__hint">{{ 'velto.delivery.next_delivery' | t }}: <span data-v="days"></span></span>
              </span>
            </velto-delivery>
          {%- endif -%}
        </div>

        <div class="velto-contact__meta">
          {%- if settings.social_instagram_link != blank or settings.social_tiktok_link != blank -%}
            <div class="velto-contact__social">
              {%- if section.settings.social_label != blank -%}
                <span class="velto-ccard__label">{% render 'velto-t', s: section.settings.social_label %}</span>
              {%- endif -%}
              <div class="velto-contact__social-links">
                {%- if settings.social_instagram_link != blank -%}
                  <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener">{{- 'icon-instagram.svg' | inline_asset_content -}}<span>@velto.lv</span></a>
                {%- endif -%}
                {%- if settings.social_tiktok_link != blank -%}
                  <a href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener">{{- 'icon-tiktok.svg' | inline_asset_content -}}<span>@velto.lv</span></a>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
          {%- if section.settings.company != blank -%}
            <div class="velto-contact__company">
              {%- if section.settings.company_label != blank -%}
                <span class="velto-ccard__label">{% render 'velto-t', s: section.settings.company_label %}</span>
              {%- endif -%}
              <span>{% render 'velto-t', s: section.settings.company %}</span>
            </div>
          {%- endif -%}
        </div>
      </div>

      <div class="velto-contact__formcard" id="velto-contact-form">
        {%- if section.settings.form_heading != blank -%}
          <h2 class="velto-contact__form-title">{% render 'velto-t', s: section.settings.form_heading %}</h2>
        {%- endif -%}
        {%- if section.settings.form_text != blank -%}
          <p class="velto-contact__form-text">{% render 'velto-t', s: section.settings.form_text %}</p>
        {%- endif -%}

        {%- form 'contact', id: 'ContactForm', class: 'velto-cform' -%}
          {%- if form.posted_successfully? -%}
            <div class="velto-cform__status is-success" role="status" tabindex="-1" autofocus>
              <span class="velto-cform__status-icon" aria-hidden="true">✓</span>
              <span>{{ 'templates.contact.form.post_success' | t }}</span>
            </div>
          {%- elsif form.errors -%}
            <div class="velto-cform__status is-error" role="alert" tabindex="-1" autofocus>
              <span class="velto-cform__status-icon" aria-hidden="true">!</span>
              <span>
                {{ 'templates.contact.form.error_heading' | t }}
                <a href="#ContactForm-email">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</a>
              </span>
            </div>
          {%- endif -%}

          {%- capture topic_label -%}{% render 'velto-t', s: section.settings.topic_label %}{%- endcapture -%}
          {%- capture topics -%}{% render 'velto-t', s: section.settings.topics %}{%- endcapture -%}
          {%- capture order_label -%}{% render 'velto-t', s: section.settings.order_label %}{%- endcapture -%}

          <div class="velto-cform__row">
            <label class="velto-cfield">
              <span>{{ 'templates.contact.form.name' | t }}</span>
              <input type="text" id="ContactForm-name" autocomplete="name" name="contact[{{ 'templates.contact.form.name' | t }}]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}">
            </label>
            <label class="velto-cfield">
              <span>{{ 'templates.contact.form.email' | t }} <em aria-hidden="true">*</em></span>
              <input
                type="email"
                id="ContactForm-email"
                autocomplete="email"
                name="contact[email]"
                spellcheck="false"
                autocapitalize="off"
                required
                aria-required="true"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                {% if form.errors contains 'email' %}aria-invalid="true" aria-describedby="ContactForm-email-error"{% endif %}
              >
            </label>
          </div>

          <div class="velto-cform__row">
            <label class="velto-cfield">
              <span>{{ 'templates.contact.form.phone' | t }}</span>
              <input type="tel" id="ContactForm-phone" autocomplete="tel" pattern="[0-9\-\+ ]*" name="contact[{{ 'templates.contact.form.phone' | t }}]" value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}">
            </label>
            <label class="velto-cfield">
              <span>{{ order_label }}</span>
              <input type="text" id="ContactForm-order" name="contact[{{ order_label | strip | escape }}]" inputmode="text">
            </label>
          </div>

          {%- assign topic_list = topics | strip | split: ',' -%}
          {%- if topic_list.size > 0 -%}
            <fieldset class="velto-cform__topics">
              <legend>{{ topic_label }}</legend>
              <div class="velto-cform__chips">
                {%- for t in topic_list -%}
                  {%- assign tv = t | strip -%}
                  <label class="velto-cchip">
                    <input type="radio" name="contact[{{ topic_label | strip | escape }}]" value="{{ tv | escape }}"{% if forloop.first %} checked{% endif %}>
                    <span>{{ tv }}</span>
                  </label>
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endif -%}

          <label class="velto-cfield">
            <span>{{ 'templates.contact.form.comment' | t }}</span>
            <textarea rows="6" id="ContactForm-body" name="contact[{{ 'templates.contact.form.comment' | t }}]">{{ form.body }}</textarea>
          </label>

          <button type="submit" class="button button--primary velto-cform__submit">
            {{ 'templates.contact.form.send' | t }}
          </button>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Velto: Kontakti",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Virsraksts (mazais)" },
    { "type": "text", "id": "heading", "label": "Virsraksts" },
    { "type": "richtext", "id": "text", "label": "Ievads" },
    { "type": "checkbox", "id": "show_page_content", "label": "Rādīt lapas saturu no Shopify", "default": false },
    { "type": "header", "content": "Kontakti" },
    { "type": "text", "id": "email", "label": "E-pasts", "default": "info@expresspoint.lv" },
    { "type": "text", "id": "email_hint", "label": "E-pasta piezīme" },
    { "type": "text", "id": "phone", "label": "Tālrunis", "default": "+371 26322465" },
    { "type": "text", "id": "hours", "label": "Darba laiks" },
    { "type": "text", "id": "social_label", "label": "Sociālo tīklu virsraksts" },
    { "type": "text", "id": "company_label", "label": "Rekvizītu virsraksts" },
    { "type": "text", "id": "company", "label": "Rekvizīti" },
    { "type": "header", "content": "Forma" },
    { "type": "text", "id": "form_heading", "label": "Formas virsraksts" },
    { "type": "text", "id": "form_text", "label": "Formas teksts" },
    { "type": "text", "id": "topic_label", "label": "Tēmas lauks" },
    { "type": "text", "id": "topics", "label": "Tēmas (ar komatu)" },
    { "type": "text", "id": "order_label", "label": "Pasūtījuma numura lauks" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 40 }
  ],
  "presets": [{ "name": "Velto: Kontakti (lapa)" }]
}
{% endschema %}
