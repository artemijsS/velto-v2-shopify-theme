{%- comment -%}
  Velto — contact band: heading + text, e-mail / phone cards, company line,
  socials (theme settings) and a shopping button.
{%- endcomment -%}
{{ 'velto-home.css' | asset_url | stylesheet_tag }}
{{ 'velto-about.css' | asset_url | stylesheet_tag }}

<section
  class="velto-acontact color-{{ section.settings.color_scheme }}"
  style="--velto-a-pt: {{ section.settings.padding_top }}px; --velto-a-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <div class="velto-acontact__card">
      <div class="velto-acontact__copy">
        {%- if section.settings.heading != blank -%}
          <h2 class="velto-a-title">{% render 'velto-t', s: section.settings.heading %}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="velto-acontact__text rte">{% render 'velto-t', s: section.settings.text %}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a class="button button--primary" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
            {%- render 'velto-t', s: section.settings.button_label -%}
          </a>
        {%- endif -%}
      </div>

      <div class="velto-acontact__ways">
        {%- if section.settings.email != blank -%}
          <a class="velto-way" href="mailto:{{ section.settings.email }}">
            <span class="velto-way__icon" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2.5" y="4.5" width="15" height="11" rx="1.5"/><path d="m3 5.5 7 5.5 7-5.5" stroke-linejoin="round"/></svg></span>
            <span class="velto-way__body">
              <span class="velto-way__label">{{ 'velto.footer.email' | t }}</span>
              <span class="velto-way__value">{{ section.settings.email }}</span>
            </span>
          </a>
        {%- endif -%}
        {%- if section.settings.phone != blank -%}
          <a class="velto-way" href="tel:{{ section.settings.phone | remove: ' ' }}">
            <span class="velto-way__icon" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6.6 2.8 8.4 6.3a1 1 0 0 1-.2 1.2L6.9 8.7a10.6 10.6 0 0 0 4.4 4.4l1.2-1.3a1 1 0 0 1 1.2-.2l3.5 1.8a1 1 0 0 1 .5 1.1l-.5 2.1a1.6 1.6 0 0 1-1.6 1.2C8.7 17.6 2.4 11.3 2.2 4.4A1.6 1.6 0 0 1 3.4 2.8l2.1-.5a1 1 0 0 1 1.1.5Z" stroke-linejoin="round"/></svg></span>
            <span class="velto-way__body">
              <span class="velto-way__label">{{ 'velto.footer.phone' | t }}</span>
              <span class="velto-way__value">{{ section.settings.phone }}</span>
              {%- if section.settings.hours != blank -%}
                <span class="velto-way__hint">{% render 'velto-t', s: section.settings.hours %}</span>
              {%- endif -%}
            </span>
          </a>
        {%- endif -%}
        {%- if settings.social_instagram_link != blank or settings.social_tiktok_link != blank -%}
          <div class="velto-way velto-way--social">
            {%- if settings.social_instagram_link != blank -%}
              <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener" aria-label="Instagram">{{- 'icon-instagram.svg' | inline_asset_content -}}<span>Instagram</span></a>
            {%- endif -%}
            {%- if settings.social_tiktok_link != blank -%}
              <a href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener" aria-label="TikTok">{{- 'icon-tiktok.svg' | inline_asset_content -}}<span>TikTok</span></a>
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- if section.settings.company != blank -%}
          <p class="velto-acontact__company">{% render 'velto-t', s: section.settings.company %}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Velto: Kontakti",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Virsraksts" },
    { "type": "richtext", "id": "text", "label": "Teksts" },
    { "type": "text", "id": "button_label", "label": "Poga" },
    { "type": "url", "id": "button_link", "label": "Pogas saite" },
    { "type": "text", "id": "email", "label": "E-pasts", "default": "info@expresspoint.lv" },
    { "type": "text", "id": "phone", "label": "Tālrunis", "default": "+371 26322465" },
    { "type": "text", "id": "hours", "label": "Darba laiks" },
    { "type": "text", "id": "company", "label": "Uzņēmums / rekvizīti" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 24 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 72 }
  ],
  "presets": [{ "name": "Velto: Kontakti" }]
}
{% endschema %}
