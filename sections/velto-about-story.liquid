{%- comment -%}
  Velto — About page: "Mūsu stāsts". The body is the page content edited in
  Shopify admin (Online Store → Pages), so the text can be changed there.
  Left column: eyebrow, heading and the brand signature; right: the text.
{%- endcomment -%}
{{ 'velto-home.css' | asset_url | stylesheet_tag }}
{{ 'velto-about.css' | asset_url | stylesheet_tag }}

{%- if page.content != blank or section.settings.fallback != blank -%}
  <section
    class="velto-astory color-{{ section.settings.color_scheme }}"
    style="--velto-a-pt: {{ section.settings.padding_top }}px; --velto-a-pb: {{ section.settings.padding_bottom }}px;"
  >
    <div class="page-width">
      <div class="velto-astory__card">
        <div class="velto-astory__side">
          {%- if section.settings.eyebrow != blank -%}
            <p class="velto-a-eyebrow">{% render 'velto-t', s: section.settings.eyebrow %}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="velto-a-title">{% render 'velto-t', s: section.settings.heading %}</h2>
          {%- endif -%}
          <div class="velto-astory__sign">
            {%- render 'velto-logo', width: 132 -%}
            {%- if section.settings.signature != blank -%}
              <span>{% render 'velto-t', s: section.settings.signature %}</span>
            {%- endif -%}
          </div>
        </div>
        <div class="velto-astory__text rte">
          {%- if page.content != blank -%}
            {{ page.content }}
          {%- else -%}
            {% render 'velto-t', s: section.settings.fallback %}
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Velto: Mūsu stāsts",
  "tag": "div",
  "settings": [
    { "type": "paragraph", "content": "Teksts ņemts no lapas satura (Online Store → Pages)." },
    { "type": "text", "id": "eyebrow", "label": "Virsraksts (mazais)" },
    { "type": "text", "id": "heading", "label": "Virsraksts" },
    { "type": "text", "id": "signature", "label": "Paraksts zem logo" },
    { "type": "richtext", "id": "fallback", "label": "Teksts, ja lapai nav satura" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 24 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 24 }
  ],
  "presets": [{ "name": "Velto: Mūsu stāsts" }]
}
{% endschema %}
