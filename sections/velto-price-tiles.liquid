{%- comment -%}
  Velto price tiles — "Godīgas cenas": big price-point tiles (līdz 1 €,
  līdz 2 € …) that open the collection with the storefront price filter
  applied (?filter.v.price.lte=N). The number of matching products is
  fetched live from the same filtered page, so it's always accurate.
{%- endcomment -%}
{{ 'velto-home.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign coll = section.settings.collection
  if coll == blank
    assign coll = collections['all']
  endif
-%}

<section
  class="velto-prices color-{{ section.settings.color_scheme }} gradient"
  style="--velto-prices-pt: {{ section.settings.padding_top }}px; --velto-prices-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <div class="velto-section-head">
      <div>
        {%- if section.settings.heading != blank -%}
          <h2 class="h2 velto-section-head__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="velto-section-head__sub">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    </div>

    <ul class="velto-prices__list" role="list">
      {%- for block in section.blocks -%}
        {%- assign url = coll.url | append: '?filter.v.price.lte=' | append: block.settings.max_price -%}
        <li class="velto-prices__item" {{ block.shopify_attributes }}>
          <a class="velto-price" href="{{ url }}" data-count-src="{{ url }}&section_id=main-collection-product-grid">
            <span class="velto-price__label">{{ section.settings.prefix }}</span>
            <span class="velto-price__value">
              <span class="velto-price__num">{{ block.settings.max_price }}</span><span class="velto-price__cur">€</span>
            </span>
            <span class="velto-price__meta">
              <span class="velto-price__count" data-count>&nbsp;</span>
              <span class="velto-price__go" aria-hidden="true">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

<script>
  (() => {
    const root = document.currentScript.previousElementSibling;
    const tiles = root.querySelectorAll('[data-count-src]');
    const plural = (n) => {
      const t = {{ section.settings.count_label | json }};
      const [one, many] = t.split('|').map((s) => s.trim());
      // Latvian: ends in 1 but not 11 → singular
      return n % 10 === 1 && n % 100 !== 11 ? one : many || one;
    };
    const load = () =>
      tiles.forEach(async (a) => {
        try {
          const html = await (await fetch(a.dataset.countSrc)).text();
          const doc = new DOMParser().parseFromString(html, 'text/html');
          const txt = doc.querySelector('#ProductCountDesktop, .product-count__text')?.textContent || '';
          const n = parseInt(txt.trim().split(/\s+/)[0], 10);
          if (!isNaN(n)) a.querySelector('[data-count]').textContent = `${n} ${plural(n)}`;
        } catch (e) {}
      });
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((e) => {
        if (e[0].isIntersecting) { io.disconnect(); load(); }
      }, { rootMargin: '300px' });
      io.observe(root);
    } else load();
  })();
</script>

{% schema %}
{
  "name": "Velto cenu līmeņi",
  "tag": "div",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "Virsraksts", "default": "Godīgas cenas katru dienu" },
    { "type": "text", "id": "subheading", "label": "Apakšvirsraksts", "default": "Izvēlies budžetu — parādīsim visu, kas tajā iekļaujas." },
    { "type": "text", "id": "prefix", "label": "Teksts virs cenas", "default": "līdz" },
    { "type": "text", "id": "count_label", "label": "Preču skaita vārds (vienskaitlis|daudzskaitlis)", "default": "prece|preces" },
    { "type": "collection", "id": "collection", "label": "Kolekcija", "info": "Ja nav izvēlēta — visi produkti." },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Atstarpe augšā", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Atstarpe apakšā", "default": 48 }
  ],
  "blocks": [
    {
      "type": "price",
      "name": "Cenas līmenis",
      "settings": [
        { "type": "number", "id": "max_price", "label": "Maksimālā cena (€)", "default": 1 }
      ]
    }
  ],
  "presets": [
    {
      "name": "Velto cenu līmeņi",
      "blocks": [
        { "type": "price", "settings": { "max_price": 1 } },
        { "type": "price", "settings": { "max_price": 2 } },
        { "type": "price", "settings": { "max_price": 3 } },
        { "type": "price", "settings": { "max_price": 5 } }
      ]
    }
  ]
}
{% endschema %}
