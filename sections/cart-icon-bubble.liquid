{% if cart == empty %}
  <span class="svg-wrapper">{{ 'icon-cart-empty.svg' | inline_asset_content }}</span>
{% else %}
  <span class="svg-wrapper">{{ 'icon-cart.svg' | inline_asset_content }}</span>
{% endif %}

<span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
{%- if cart != empty -%}
  <div class="cart-count-bubble">
    {%- capture velto_goods -%}{% render 'velto-goods-count' %}{%- endcapture -%}{%- assign velto_goods = velto_goods | plus: 0 -%}
            {%- if velto_goods < 100 -%}
      <span aria-hidden="true">{{ velto_goods }}</span>
    {%- endif -%}
    <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: velto_goods }}</span>
  </div>
{%- endif -%}
