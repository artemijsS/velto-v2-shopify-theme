{%- comment -%}
  Velto — a single product card (same look as the collection grid),
  fetched by assets/velto-mine-filter.js: /products/<handle>?view=card
{%- endcomment -%}
{%- layout none -%}
<li class="grid__item">
  {% render 'card-product',
    card_product: product,
    media_aspect_ratio: 'square',
    image_shape: 'default',
    show_secondary_image: false,
    show_vendor: false,
    show_rating: false,
    lazy_load: true,
    skip_styles: true,
    quick_add: 'standard',
    section_id: 'velto-mine',
    product_view_context: 'collection'
  %}
</li>
