{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": false,
            "show_gift_card_recipient": true
          }
        },
        "description": {
          "type": "description"
        },
        "velto_delivery": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'velto-delivery-info' %}"
          }
        },
        "velto_badges": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'velto-product-badges', product: product, style: 'page' %}"
          }
        },
        "velto_crumbs": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'velto-product-crumbs', product: product %}"
          }
        }
      },
      "block_order": [
        "velto_crumbs",
        "vendor",
        "title",
        "velto_badges",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "velto_delivery",
        "description"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "stacked",
        "media_size": "medium",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "@velto.content.product.related",
        "heading_size": "h2",
        "products_to_show": 5,
        "columns_desktop": 5,
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    }
  },
  "order": [
    "main",
    "disclosures",
    "related-products"
  ]
}
