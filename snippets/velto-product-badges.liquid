{%- comment -%}
  Velto product badges — "18+", "Ekskluzīvs" and "Lieliska cena".
  Rules (theme settings → "Velto marķējumi"):
    18+        : product has the tag settings.velto_badge_adult_tag (default "18+");
                 accent (red) colour — the only badge that is a warning, not a perk
    exclusive  : product has the tag settings.velto_badge_exclusive_tag (default "exclusive")
    great price: metafield custom.price_category ≥ settings.velto_badge_price_min (default 4)
                 — the same values the storefront filter "Cenas kategorija → Lieliska cena" groups.
                 On a card it says how much below the market the price is and opens the
                 comparison with other stores (snippets/velto-price-compare.liquid)

  Usage:
    {% render 'velto-product-badges', product: card_product, style: 'card' %}  – over the card image
    {% render 'velto-product-badges', product: product, style: 'page' %}       – product page, with explanations
{%- endcomment -%}
{%- if settings.velto_badges_enable -%}
  {%- liquid
    assign ex_tag = settings.velto_badge_exclusive_tag | default: 'exclusive' | strip | downcase
    assign is_exclusive = false
    for t in product.tags
      assign tl = t | downcase
      if tl == ex_tag
        assign is_exclusive = true
        break
      endif
    endfor

    assign adult_tag = settings.velto_badge_adult_tag | default: '18+' | strip | downcase
    assign is_adult = false
    for t in product.tags
      assign tl = t | strip | downcase
      if tl == adult_tag
        assign is_adult = true
        break
      endif
    endfor

    assign pc = product.metafields.custom.price_category.value | plus: 0
    assign pmin = settings.velto_badge_price_min | plus: 0
    assign is_great = false
    if pmin > 0 and pc >= pmin
      assign is_great = true
    endif
  -%}
  {%- if is_exclusive or is_great or is_adult -%}
    {%- if style == 'page' -%}
      <ul class="velto-pbadges velto-pbadges--page" role="list">
        {%- if is_adult -%}
          <li class="velto-pbadge velto-pbadge--adult">
            <span class="velto-pbadge__pill">{{ 'velto.badges.adult' | t }}</span>
            <span class="velto-pbadge__note">{{ 'velto.badges.adult_note' | t }}</span>
          </li>
        {%- endif -%}
        {%- if is_exclusive -%}
          <li class="velto-pbadge velto-pbadge--exclusive">
            <span class="velto-pbadge__pill">
              <span class="velto-pbadge__icon" aria-hidden="true">✦</span>
              {{- 'velto.badges.exclusive' | t -}}
            </span>
            <span class="velto-pbadge__note">{{ 'velto.badges.exclusive_note' | t }}</span>
          </li>
        {%- endif -%}
        {%- if is_great -%}
          <li class="velto-pbadge velto-pbadge--price">
            <span class="velto-pbadge__pill">
              <span class="velto-pbadge__icon" aria-hidden="true">{{- 'icon-price-tag.svg' | inline_asset_content -}}</span>
              {{- 'velto.badges.great_price' | t -}}
            </span>
            {%- comment -%} how much below the market when Cenu Depo knows it, the general note otherwise {%- endcomment -%}
            {%- capture cmp_pct -%}{%- render 'velto-price-compare', product: product, style: 'pct' -%}{%- endcapture -%}
            {%- assign cmp_pct = cmp_pct | strip | plus: 0 -%}
            <span class="velto-pbadge__note">
              {%- if cmp_pct >= 1 -%}
                {{- 'velto.compare.cheaper' | t: value: cmp_pct -}}
              {%- else -%}
                {{- 'velto.badges.great_price_note' | t -}}
              {%- endif -%}
            </span>
          </li>
        {%- endif -%}
      </ul>
    {%- else -%}
      <ul class="velto-pbadges velto-pbadges--card" role="list">
        {%- if is_adult -%}
          <li class="velto-pbadge velto-pbadge--adult" title="{{ 'velto.badges.adult_note' | t | escape }}">
            {{- 'velto.badges.adult' | t -}}
          </li>
        {%- endif -%}
        {%- if is_exclusive -%}
          <li class="velto-pbadge velto-pbadge--exclusive">
            <span class="velto-pbadge__icon" aria-hidden="true">✦</span>{{ 'velto.badges.exclusive' | t }}
          </li>
        {%- endif -%}
        {%- if is_great -%}
          {%- comment -%} how much below the market, and — when Cenu Depo can show it — a button that opens the comparison {%- endcomment -%}
          {%- capture cmp_pct -%}{%- render 'velto-price-compare', product: product, style: 'pct' -%}{%- endcapture -%}
          {%- capture cmp_attrs -%}{%- render 'velto-price-compare', product: product, style: 'attrs' -%}{%- endcapture -%}
          {%- liquid
            assign cmp_pct = cmp_pct | strip | plus: 0
            assign cmp_attrs = cmp_attrs | strip
            if cmp_pct >= 1
              assign great_label = 'velto.compare.below_market' | t: value: cmp_pct
            else
              assign great_label = 'velto.badges.great_price' | t
            endif
          -%}
          <li class="velto-pbadge velto-pbadge--price{% if cmp_attrs != blank %} velto-pbadge--compare{% endif %}">
            {%- if cmp_attrs != blank -%}
              <button type="button" class="velto-pbadge__btn" {{ cmp_attrs }} aria-label="{{ great_label | escape }}. {{ 'velto.compare.button' | t | escape }}">
                <span class="velto-pbadge__icon" aria-hidden="true">{{- 'icon-price-tag.svg' | inline_asset_content -}}</span>{{ great_label }}
              </button>
            {%- else -%}
              <span class="velto-pbadge__icon" aria-hidden="true">{{- 'icon-price-tag.svg' | inline_asset_content -}}</span>{{ great_label }}
            {%- endif -%}
          </li>
        {%- endif -%}
      </ul>
    {%- endif -%}
  {%- endif -%}
{%- endif -%}
