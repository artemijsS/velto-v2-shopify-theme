{%- comment -%}
  Velto — price against other stores (data of Cenu Depo, written daily by the worker into
  custom.price_category and custom.price_percentage_diff_to_average).

  Sets, for the product:
    eligible : a comparison can be opened — the variant has a barcode, Cenu Depo knows the
               product, it is not a service product and not an exclusive (sold only here)
    pct      : whole % below the average market price; 0 unless the price is "great"
               (price_category ≥ settings.velto_badge_price_min)

  style: 'page' – product page, under the price: "great price" pill, how much cheaper,
                  and the "compare prices" button
         'attrs' – only the attributes that turn an element into the button that opens the
                  comparison (used by the "great price" badge of a card); nothing when not eligible
         'pct'   – only the number, for the caller's own text

  The dialog is snippets/velto-compare-dialog.liquid, opened by assets/velto-compare.js.
{%- endcomment -%}
{%- liquid
  assign cmp_barcode = product.selected_or_first_available_variant.barcode | strip
  assign cmp_category = product.metafields.custom.price_category.value | plus: 0
  assign cmp_min = settings.velto_badge_price_min | plus: 0

  assign cmp_ex_tag = settings.velto_badge_exclusive_tag | default: 'exclusive' | strip | downcase
  assign cmp_exclusive = false
  for t in product.tags
    assign tl = t | strip | downcase
    if tl == cmp_ex_tag
      assign cmp_exclusive = true
      break
    endif
  endfor

  assign cmp_eligible = false
  if settings.velto_compare_enable and cmp_barcode != blank and cmp_category > 0 and cmp_exclusive == false and product.vendor != 'ExpressPoint'
    assign cmp_eligible = true
  endif

  assign cmp_great = false
  assign cmp_pct = 0
  if cmp_min > 0 and cmp_category >= cmp_min
    assign cmp_great = true
    assign cmp_pct = product.metafields.custom.price_percentage_diff_to_average.value | abs | round
  endif
-%}
{%- if style == 'pct' -%}
  {{- cmp_pct -}}
{%- elsif style == 'attrs' -%}
  {%- if cmp_eligible -%}
    data-velto-compare data-barcode="{{ cmp_barcode | escape }}" data-title="{{ product.title | escape }}"
  {%- endif -%}
{%- elsif cmp_eligible or cmp_great -%}
  <div class="velto-cmp{% if cmp_great %} velto-cmp--great{% endif %}">
    {%- if cmp_great -%}
      <p class="velto-cmp__lead">
        <span class="velto-cmp__pill">
          <span class="velto-cmp__icon" aria-hidden="true">{{- 'icon-price-tag.svg' | inline_asset_content -}}</span>
          {{- 'velto.badges.great_price' | t -}}
        </span>
        <span class="velto-cmp__note">
          {%- if cmp_pct >= 1 -%}
            {{- 'velto.compare.cheaper' | t: value: cmp_pct -}}
          {%- else -%}
            {{- 'velto.badges.great_price_note' | t -}}
          {%- endif -%}
        </span>
      </p>
    {%- endif -%}
    {%- if cmp_eligible -%}
      <button
        type="button"
        class="velto-cmp__btn"
        data-velto-compare
        data-barcode="{{ cmp_barcode | escape }}"
        data-title="{{ product.title | escape }}"
      >
        <svg class="velto-cmp__chart" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 16V9M10 16V4M16 16v-5"/></svg>
        <span>{{ 'velto.compare.button' | t }}</span>
        <span class="velto-cmp__arrow" aria-hidden="true">→</span>
      </button>
    {%- endif -%}
  </div>
{%- endif -%}
