{%- comment -%}
  Outputs the weekdays on which orders are delivered or picked up, as "5,6,7"
  (1 = Monday … 7 = Sunday). Used by every text and banner about the weekly
  cycle (velto-t, velto-delivery, velto-delivery-info, header, footer).

  With the own delivery block on (theme settings → "Velto: sava piegāde") the
  days are the real ones: every weekday that has delivery or pickup slots in
  the velto_delivery_day metaobjects. Otherwise (or if there are none) —
  theme settings → "Velto piegāde" → delivery days.

  Usage: {% render 'velto-delivery-days' %}
         {%- capture days -%}{% render 'velto-delivery-days' %}{%- endcapture -%}
{%- endcomment -%}
{%- liquid
  assign vdd = ''
  if settings.velto_fulfil_enable
    assign vdd_entries = shop.metaobjects.velto_delivery_day.values
    for wd in (1..7)
      for d in vdd_entries
        if d.weekday.value == wd and d.slots.value.size > 0
          if vdd != ''
            assign vdd = vdd | append: ','
          endif
          assign vdd = vdd | append: wd
          break
        endif
      endfor
    endfor
  endif
  if vdd == ''
    assign vdd = settings.velto_delivery_days | default: '5,6,7' | remove: ' '
  endif
  echo vdd
-%}
