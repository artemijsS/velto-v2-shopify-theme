{%- comment -%}
  Velto — SEO and social meta tags: description, robots, Open Graph, Twitter.

  Description: the one from Shopify admin (page / product / collection SEO
  fields) when there is one. Fallbacks, so that no indexable page is left
  without a description:
    home         velto.seo.home_description — also used when the admin text is
                 shorter than 60 characters (an untranslated slogan)
    collection   velto.seo.collection_description (title + number of products)
    delivery     velto.fulfil_page.intro (page template "delivery")
  Robots: search results, the cart and the "My purchases" pages are noindex.
{%- endcomment -%}
{%- liquid
  assign seo_description = page_description | strip
  if request.page_type == 'index'
    if seo_description.size < 60
      assign seo_description = 'velto.seo.home_description' | t
    endif
  elsif request.page_type == 'collection' and seo_description == blank
    assign seo_ex_tag = settings.velto_badge_exclusive_tag | default: 'exclusive' | downcase
    assign seo_title = collection.title
    assign seo_count = collection.all_products_count
    if current_tags
      assign seo_count = collection.products_count
    endif
    if collection.handle == 'all'
      assign seo_title = 'velto.collection.all_title' | t
      if current_tags contains seo_ex_tag
        assign seo_title = 'velto.collection.exclusive_title' | t
      endif
    elsif current_tags contains seo_ex_tag
      assign seo_ex_label = 'velto.badges.exclusive_filter' | t
      assign seo_title = seo_title | append: ' · ' | append: seo_ex_label
    endif
    assign seo_count_label = 'velto.products_count' | t: count: seo_count
    assign seo_description = 'velto.seo.collection_description' | t: title: seo_title, count: seo_count_label
  elsif request.page_type == 'page' and seo_description == blank and template.suffix == 'delivery'
    assign seo_description = 'velto.fulfil_page.intro' | t
  endif

  assign seo_noindex = false
  if request.page_type == 'search' or request.page_type == 'cart'
    assign seo_noindex = true
  elsif request.page_type == 'page'
    if template.suffix == 'mine' or template.suffix == 'mine-data'
      assign seo_noindex = true
    endif
  endif

  assign og_title = page_title | default: shop.name
  if request.page_type == 'index' and settings.velto_seo_home_title
    assign og_title = 'velto.seo.home_title' | t
  endif
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = seo_description | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif

  assign og_locales = 'lv:lv_LV,ru:ru_RU,en:en_GB' | split: ','
%}

{%- if seo_description != blank %}
<meta name="description" content="{{ seo_description | strip_html | strip_newlines | escape }}">
{%- endif %}
{%- if seo_noindex %}
<meta name="robots" content="noindex, follow">
{%- endif %}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | strip_html | strip_newlines | escape }}">
{%- for pair in og_locales -%}
  {%- assign og_pair = pair | split: ':' -%}
  {%- if og_pair[0] == request.locale.iso_code %}
<meta property="og:locale" content="{{ og_pair[1] }}">
  {%- else -%}
    {%- for loc in shop.published_locales -%}
      {%- if loc.iso_code == og_pair[0] %}
<meta property="og:locale:alternate" content="{{ og_pair[1] }}">
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endfor %}

{%- if page_image -%}
  <meta property="og:image" content="http:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="{{ page_image.width }}">
  <meta property="og:image:height" content="{{ page_image.height }}">
  <meta name="twitter:image" content="https:{{ page_image | image_url: width: 1200 }}">
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta name="twitter:site" content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | strip_html | strip_newlines | escape }}">
