{%- comment -%}
  Velto desktop sub-navigation (≥990px), rendered under the header row:
  [☰ Katalogs] catalog panel (categories left, subcategories right,
  switching on hover) · quick links · live delivery line.
  Mobile keeps Dawn's drawer menu.

  Params: menu (link_list), section (header section, for quick-link settings)
{%- endcomment -%}
{%- if menu != blank and menu.links.size > 0 -%}
  <div class="velto-subnav">
    <div class="page-width velto-subnav__inner">
      <velto-catalog class="velto-catalog">
        <button
          type="button"
          class="velto-catalog__toggle"
          aria-expanded="false"
          aria-controls="VeltoCatalogPanel"
        >
          <span class="velto-catalog__burger" aria-hidden="true"><span></span><span></span><span></span></span>
          {{ 'velto.nav.catalog' | t }}
        </button>

        <div class="velto-catalog__panel" id="VeltoCatalogPanel" hidden>
          <ul class="velto-catalog__cats" role="list">
            {%- comment -%} ci: position among the shown categories (velto-catalog.js pairs category ↔ pane by it) {%- endcomment -%}
            {%- assign ci = 0 -%}
            {%- for link in menu.links -%}
              {%- liquid
                comment
                  Velto: categories without products are not shown (unless it is the open page);
                  vis = sub-categories of this link that will be shown
                endcomment
                assign vis = 0
                for c in link.links
                  if c.url == link.url
                    continue
                  endif
                  if c.type == 'collection_link' and c.object.all_products_count == 0 and c.active == false
                    continue
                  endif
                  assign vis = vis | plus: 1
                endfor
              -%}
              {%- if link.type == 'collection_link' and link.object.all_products_count == 0 and link.active == false and vis == 0 -%}{%- continue -%}{%- endif -%}
              <li>
                <a
                  href="{{ link.url }}"
                  class="velto-catalog__cat{% if ci == 0 %} is-active{% endif %}{% if link.active or link.child_active %} is-current{% endif %}"
                  data-index="{{ ci }}"
                >
                  <span>{{ link.title | remove: '💙' | strip }}</span>
                  {%- if vis > 0 -%}
                    <span class="velto-catalog__chev" aria-hidden="true">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
                  {%- endif -%}
                </a>
              </li>
              {%- assign ci = ci | plus: 1 -%}
            {%- endfor -%}
          </ul>

          <div class="velto-catalog__panes">
            {%- assign ci = 0 -%}
            {%- for link in menu.links -%}
              {%- liquid
                comment
                  Velto: categories without products are not shown (unless it is the open page);
                  vis = sub-categories of this link that will be shown
                endcomment
                assign vis = 0
                for c in link.links
                  if c.url == link.url
                    continue
                  endif
                  if c.type == 'collection_link' and c.object.all_products_count == 0 and c.active == false
                    continue
                  endif
                  assign vis = vis | plus: 1
                endfor
              -%}
              {%- if link.type == 'collection_link' and link.object.all_products_count == 0 and link.active == false and vis == 0 -%}{%- continue -%}{%- endif -%}
              <div class="velto-catalog__pane{% if ci == 0 %} is-active{% endif %}" data-index="{{ ci }}">
              {%- assign ci = ci | plus: 1 -%}
                <div class="velto-catalog__pane-head">
                  <p class="velto-catalog__pane-title">{{ link.title | remove: '💙' | strip }}</p>
                  <a class="velto-catalog__pane-all" href="{{ link.url }}">
                    {{- 'velto.nav.view_all' | t }} <span aria-hidden="true">→</span>
                  </a>
                </div>
                {%- if vis > 0 -%}
                  <ul class="velto-catalog__subs" role="list">
                    {%- for child in link.links -%}
                      {%- if child.url == link.url -%}{%- continue -%}{%- endif -%}
                      {%- if child.type == 'collection_link' and child.object.all_products_count == 0 and child.active == false -%}{%- continue -%}{%- endif -%}
                      {%- liquid
                        assign img = nil
                        if child.type == 'collection_link' and child.object
                          assign img = child.object.featured_image
                          if img == blank
                            assign img = child.object.products.first.featured_media.preview_image
                          endif
                        endif
                      -%}
                      <li>
                        <a class="velto-catalog__sub{% if child.active or child.child_active %} is-current{% endif %}" href="{{ child.url }}"{% if child.active %} aria-current="page"{% endif %}>
                          <span class="velto-catalog__sub-img">
                            {%- if img != blank -%}
                              {{ img | image_url: width: 120 | image_tag: loading: 'lazy', sizes: '48px', widths: '120', alt: '' }}
                            {%- endif -%}
                          </span>
                          <span class="velto-catalog__sub-title">{{ child.title }}</span>
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- else -%}
                  <p class="velto-catalog__empty">
                    <a class="button button--secondary" href="{{ link.url }}">{{ 'velto.nav.view_all' | t }}</a>
                  </p>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        </div>
      </velto-catalog>

      <nav class="velto-subnav__quick" aria-label="{{ 'velto.nav.quick' | t | escape }}">
        <ul role="list">
          {%- render 'velto-halloween-link', class: '' -%}
          {%- if settings.velto_mine_enable -%}
            <li><a class="velto-mine-link" href="{% render 'velto-mine-url' %}" data-velto-quick><span class="velto-mine-link__icon"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 10a6.5 6.5 0 0 1 11.3-4.4L16.5 7.5"/><path d="M16.5 3.5v4h-4"/><path d="M16.5 10a6.5 6.5 0 0 1-11.3 4.4L3.5 12.5"/><path d="M3.5 16.5v-4h4"/></svg></span>{{ 'velto.mine.nav_label' | t }}</a></li>
          {%- endif -%}
          {%- for i in (1..5) -%}
            {%- liquid
              assign lk = 'velto_quick_label_' | append: i
              assign uk = 'velto_quick_url_' | append: i
              assign ql = section.settings[lk]
              assign qu = section.settings[uk] | replace: 'shopify://collections/', '/collections/' | replace: 'shopify://pages/', '/pages/' | replace: 'shopify://products/', '/products/'
            -%}
            {%- if ql != blank and qu != blank -%}
              <li><a href="{% render 'velto-url', url: qu %}" data-velto-quick>{% render 'velto-t', s: ql %}{% render 'velto-quick-count', url: qu, section: section %}</a></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </nav>

      {%- if settings.velto_delivery_enable -%}
        <velto-delivery
          class="velto-subnav__deliv"
          data-cutoff-day="{{ settings.velto_cutoff_day }}"
          data-cutoff-time="{{ settings.velto_cutoff_time }}"
          data-delivery-days="{% render 'velto-delivery-days' %}"
        >
          {%- comment -%} links to the "Delivery and pickup" page once it is chosen (theme settings → "Velto: sava piegāde") {%- endcomment -%}
          {%- if settings.velto_fulfil_page != blank -%}
            <a
              class="velto-subnav__deliv-link"
              href="{{ settings.velto_fulfil_page.url }}"
              title="{{ 'velto.facts.more' | t | escape }}"
            >
          {%- endif -%}
          <span class="velto-subnav__deliv-icon" aria-hidden="true">{{- 'icon-truck.svg' | inline_asset_content -}}</span>
          <span>{{ 'velto.delivery.order' | t }} <strong data-v="deadline"></strong></span>
          {%- if settings.velto_fulfil_page != blank -%}
            </a>
          {%- endif -%}
        </velto-delivery>
        <script src="{{ 'velto-delivery.js' | asset_url }}" defer="defer"></script>
      {%- endif -%}
    </div>
  </div>
  <div class="velto-catalog__backdrop" hidden></div>
  <script src="{{ 'velto-catalog.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
